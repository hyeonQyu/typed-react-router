{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {},
    "type": {
      // The examples resolve `@hyeonqyu/typed-router-*` through node_modules, which
      // points at `dist` — so on a fresh checkout they type-check against a build that
      // does not exist yet, and on a stale one against code that no longer matches
      // `src`. Depending on `^build` makes `yarn type` mean the same thing everywhere.
      "dependsOn": ["^build"]
    }
  }
}
